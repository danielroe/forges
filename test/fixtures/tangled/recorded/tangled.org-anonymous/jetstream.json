          "$type": "org.tangled.track.ticket",
          "body": {
            "$type": "org.tangled.markup.markdown",
            "text": "Fixture paths contain ':' (DIDs), which Go module zips reject, so no\ntagged version since v1.20.0 can be fetched with go get. A go.mod in\nthe directory makes the go command leave it out of the module zip.\n\nSigned-off-by: Evan Jarrett <evan@evanjarrett.com>"
          },
          "createdAt": "2026-11-21T17:59:27Z",
          "state": "open",
          "targetBranch": "master",
          "title": {
            "$type": "org.tangled.markup.markdown#inline",
            "text": "localinfra/fixtures: exclude fixtures from the module zip"
          },
          "x-tngl-editor": "did:plc:pddp4xt5lgnv2qsegbzzs4xg"
        },
        "cid": "bafyreiavzq4xpb6pbr3ds6idkwrxygpulzxfeuio65gr6zy73bal2zkdby"
      }
    },
