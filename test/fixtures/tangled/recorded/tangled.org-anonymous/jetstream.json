      "commit": {
        "rev": "3n2tnncq7fo22",
        "operation": "create",
        "collection": "org.tangled.track.ticket",
        "rkey": "176",
        "record": {
          "$type": "org.tangled.track.ticket",
          "body": {
            "$type": "org.tangled.markup.markdown",
            "text": "The microvm workflows resolved `github:nixos/nixpkgs/nixos-unstable` during spindle setup, which calls api.github.com anonymously from the shared runner IP and fails with 403 once that quota is gone; deploy-microvm has not published an image since. Floating via `https://channels.nixos.org/nixos-unstable/nixexprs.tar.xz` keeps unstable without touching GitHub. test-postgres.yml runs on this PR on the same engine, so a green run proves the ref."
          },
          "createdAt": "2026-11-21T17:43:37Z",
          "state": "open",
          "targetBranch": "main",
          "title": {
            "$type": "org.tangled.markup.markdown#inline",
            "text": "ci: float nixpkgs via the channel tarball to dodge github api rate limits"
          },
          "x-tngl-editor": "did:plc:r5bee2hexwjtmhkfmfu2tphx"
        },
        "cid": "bafyreidvco4exiisabdlz7leiphq4o6rvgmexidbwbg6wtjsuj755ghpde"
