      "detail": {
        "type": "comment",
        "comment": {
          "forge": "forgejo",
          "instance": "code.forgejo.org",
          "thread": {
            "forge": "forgejo",
            "instance": "code.forgejo.org",
            "repo": {
              "forge": "forgejo",
