    {
      "forge": "forgejo",
      "instance": "codeberg.org",
      "id": "254933567",
      "kindRaw": "comment_issue",
      "kind": "comment",
      "action": "created",
      "thread": {
        "forge": "forgejo",
        "instance": "codeberg.org",
        "repo": {
          "forge": "forgejo",
