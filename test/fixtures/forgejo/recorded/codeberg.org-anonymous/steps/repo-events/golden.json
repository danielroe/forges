      "detail": {
        "type": "comment",
        "comment": {
          "forge": "forgejo",
          "instance": "codeberg.org",
          "thread": {
            "forge": "forgejo",
            "instance": "codeberg.org",
            "repo": {
              "forge": "forgejo",
