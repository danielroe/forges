        "title": "fix(src/bin/radicle-job.rs): add missing elided hidden lifetime",
        "state": {
          "status": "merged",
          "revision": "3d07d80a9caac14786f60915fd8d4fb4cb80858f",
          "commit": "6a23756c2ea6b1d6e23f0778ec81851db6e7df54"
        },
        "target": "delegates",
        "labels": [],
        "merges": [
          {
            "author": {
              "id": "did:key:z6MkireRatUThvd3qzfKht1S44wpm4FEWSSa4PRMTSQZ3voM",
              "alias": "fintohaps"
            },
            "commit": "6a23756c2ea6b1d6e23f0778ec81851db6e7df54",
            "timestamp": 1755615203,
            "revision": "3d07d80a9caac14786f60915fd8d4fb4cb80858f"
          }
        ],
        "assignees": [],
        "revisions": [
          {
            "id": "7e6d4ecd33f73570bc08f8d8e58035c2cb75a70a",
            "author": {
              "id": "did:key:z6MkgEMYod7Hxfy9qCvDv5hYHkZ4ciWmLFgfvm3Wn1b2w2FV",
              "alias": "liw"
            },
            "description": "The elided hidden lifetime in the return type can lead to confusion,\nand from Rust 1.89.0 the compiler warns about it by default. Avoid the\nwarning by making the elided lifetime explicit.\n\nThe release blog post explains this:\nhttps://blog.rust-lang.org/2025/08/07/Rust-1.89.0/#mismatched-lifetime-syntaxes-lint\n\nSigned-off-by: Lars Wirzenius <redacted@example.invalid>",
            "edits": [
              {
                "author": {
                  "id": "did:key:z6MkgEMYod7Hxfy9qCvDv5hYHkZ4ciWmLFgfvm3Wn1b2w2FV",
                  "alias": "liw"
                },
                "body": "The elided hidden lifetime in the return type can lead to confusion,\nand from Rust 1.89.0 the compiler warns about it by default. Avoid the\nwarning by making the elided lifetime explicit.\n\nThe release blog post explains this:\nhttps://blog.rust-lang.org/2025/08/07/Rust-1.89.0/#mismatched-lifetime-syntaxes-lint\n\nSigned-off-by: Lars Wirzenius <redacted@example.invalid>",
