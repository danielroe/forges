{
  "name": "forges",
  "type": "module",
  "version": "0.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "description": "One client, every forge: issues, pull requests, notifications, checks and webhooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/forges.git"
  },
  "keywords": [
    "forge",
    "git",
    "github",
    "gitlab",
    "bitbucket",
    "forgejo",
    "codeberg",
    "gitea",
    "gitee",
    "azure-devops",
    "tangled",
    "atproto",
    "issues",
    "pull-requests",
    "notifications",
    "webhooks"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./azure-devops": "./src/azure-devops/index.ts",
    "./bitbucket": "./src/bitbucket/index.ts",
    "./cloudflare-artifacts": "./src/cloudflare-artifacts/index.ts",
    "./cursor-origin": "./src/cursor-origin/index.ts",
    "./env": "./src/env.ts",
    "./fake": "./src/fake/index.ts",
    "./forgejo": "./src/forgejo/index.ts",
    "./gitea": "./src/gitea/index.ts",
    "./gitee": "./src/gitee/index.ts",
    "./github": "./src/github/index.ts",
    "./gitlab": "./src/gitlab/index.ts",
    "./kit": "./src/kit.ts",
    "./pushin": "./src/pushin/index.ts",
    "./schema": "./src/schema/index.ts",
    "./sourcehut": "./src/sourcehut/index.ts",
    "./tangled": "./src/tangled/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json",
    "./schema/*.json": "./dist/schema/*.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./azure-devops": "./dist/azure-devops/index.mjs",
      "./bitbucket": "./dist/bitbucket/index.mjs",
      "./cloudflare-artifacts": "./dist/cloudflare-artifacts/index.mjs",
      "./cursor-origin": "./dist/cursor-origin/index.mjs",
      "./env": "./dist/env.mjs",
      "./fake": "./dist/fake/index.mjs",
      "./forgejo": "./dist/forgejo/index.mjs",
      "./gitea": "./dist/gitea/index.mjs",
      "./gitee": "./dist/gitee/index.mjs",
      "./github": "./dist/github/index.mjs",
      "./gitlab": "./dist/gitlab/index.mjs",
      "./kit": "./dist/kit.mjs",
      "./pushin": "./dist/pushin/index.mjs",
      "./schema": "./dist/schema/index.mjs",
      "./sourcehut": "./dist/sourcehut/index.mjs",
      "./tangled": "./dist/tangled/index.mjs",
      "./testing": "./dist/testing/index.mjs",
      "./package.json": "./package.json",
      "./schema/*.json": "./dist/schema/*.json"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown",
    "build:docs": "pnpm --filter forges-docs build",
    "check:all": "pnpm lint && pnpm test && pnpm build && pnpm test:size",
    "dev": "vitest dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "test": "pnpm test:unit && pnpm test:capabilities && pnpm test:types && pnpm test:knip",
    "test:unit": "vitest run --project unit",
    "test:docs": "vitest run --project docs",
    "test:capabilities": "node scripts/check-capabilities.ts",
    "test:knip": "knip",
    "test:links": "lychee --config lychee.toml --remap \"https://github\\.com/danielroe/forges/(?:blob|tree)/main/(.*) file://$PWD/\\$1\" --include-fragments docs/.output/public README.md CONTRIBUTING.md CODE_OF_CONDUCT.md docs/README.md docs/content examples test/fixtures",
    "test:types": "tsc --noEmit",
    "dev:docs": "pnpm --filter forges-docs dev",
    "dev:playground": "pnpm --filter playground dev",
    "record-fixtures": "node --env-file-if-exists=.env scripts/record-fixtures.ts",
    "capability-matrix": "node scripts/capability-matrix.ts",
    "capability-diff": "node scripts/capability-diff.ts",
    "recorded-coverage": "node scripts/recorded-coverage.ts",
    "docs:api": "node scripts/docs-api.ts",
    "test:size": "node scripts/bundle-size.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@arethetypeswrong/core": "0.18.5",
    "@octokit/openapi-webhooks-types": "12.2.0",
    "@octokit/rest": "22.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "knip": "6.41.0",
    "nano-staged": "1.0.2",
    "pkg-pr-new": "0.0.91",
    "publint": "0.3.25",
    "rolldown": "1.2.14",
    "simple-git-hooks": "2.14.0",
    "ts-json-schema-generator": "2.9.0",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,vue,json,yml,yaml,md,.*rc}": [
      "pnpm eslint --fix"
    ]
  }
}
