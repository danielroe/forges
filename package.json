{
  "name": "forges",
  "type": "module",
  "version": "0.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "description": "One API for issues, pull requests, notifications and webhooks across GitHub, GitLab, Bitbucket, Forgejo, Gitea, Gitee, Azure DevOps, Cursor Origin, Tangled and pushin.eu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/forges.git"
  },
  "keywords": [
    "forge",
    "git",
    "github",
    "gitlab",
    "bitbucket",
    "forgejo",
    "codeberg",
    "gitea",
    "gitee",
    "azure-devops",
    "tangled",
    "atproto",
    "issues",
    "pull-requests",
    "notifications",
    "webhooks"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./azure-devops": "./src/azure-devops/index.ts",
    "./bitbucket": "./src/bitbucket/index.ts",
    "./cursor-origin": "./src/cursor-origin/index.ts",
    "./env": "./src/env.ts",
    "./fake": "./src/fake/index.ts",
    "./forgejo": "./src/forgejo/index.ts",
    "./gitea": "./src/gitea/index.ts",
    "./gitee": "./src/gitee/index.ts",
    "./github": "./src/github/index.ts",
    "./gitlab": "./src/gitlab/index.ts",
    "./pushin": "./src/pushin/index.ts",
    "./schema": "./src/schema/index.ts",
    "./tangled": "./src/tangled/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json",
    "./schema/*.json": "./dist/schema/*.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./azure-devops": "./dist/azure-devops/index.mjs",
      "./bitbucket": "./dist/bitbucket/index.mjs",
      "./cursor-origin": "./dist/cursor-origin/index.mjs",
      "./env": "./dist/env.mjs",
      "./fake": "./dist/fake/index.mjs",
      "./forgejo": "./dist/forgejo/index.mjs",
      "./gitea": "./dist/gitea/index.mjs",
      "./gitee": "./dist/gitee/index.mjs",
      "./github": "./dist/github/index.mjs",
      "./gitlab": "./dist/gitlab/index.mjs",
      "./pushin": "./dist/pushin/index.mjs",
      "./schema": "./dist/schema/index.mjs",
      "./tangled": "./dist/tangled/index.mjs",
      "./testing": "./dist/testing/index.mjs",
      "./package.json": "./package.json",
      "./schema/*.json": "./dist/schema/*.json"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown && node scripts/generate-schemas.ts --dist",
    "dev": "vitest dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "test": "pnpm test:unit && pnpm test:capabilities && pnpm test:types && pnpm test:knip",
    "test:unit": "vitest run",
    "test:capabilities": "node scripts/check-capabilities.ts",
    "test:knip": "knip",
    "test:versions": "installed-check -d --no-workspaces",
    "test:types": "tsc --noEmit",
    "dev:playground": "pnpm --filter playground dev",
    "record-fixtures": "node --env-file-if-exists=.env scripts/record-fixtures.ts",
    "capability-matrix": "node scripts/capability-matrix.ts",
    "test:size": "node scripts/bundle-size.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@arethetypeswrong/core": "0.18.5",
    "@octokit/openapi-webhooks-types": "12.1.0",
    "@octokit/rest": "22.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "installed-check": "11.0.0",
    "knip": "6.39.0",
    "nano-staged": "1.0.2",
    "pkg-pr-new": "0.0.88",
    "publint": "0.3.25",
    "rolldown": "1.2.12",
    "simple-git-hooks": "2.14.0",
    "ts-json-schema-generator": "2.9.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,yml,yaml,md,.*rc}": [
      "pnpm eslint --fix"
    ]
  }
}
