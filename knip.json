{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["lychee"],
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": ["docs", "playground"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/sections/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    }
  }
}
